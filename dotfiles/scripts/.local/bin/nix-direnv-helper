#!/usr/bin/env bash

set -euo pipefail

TEMPLATES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nix-direnv-helper/templates"
CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/direnv/layouts"

function templates {
    nix eval --raw --file "${TEMPLATES_DIR}/default.nix" \
        --apply 't: builtins.concatStringsSep "\n" (builtins.attrNames t) + "\n"'
}

function tools {
    compgen -A function | sed -rn 's/tool:(.*)/\1/p'
}

function tool:init {
    # TEMPLATES_DIR is a symlink, and a path: flake cannot have a symlinked root.
    nix flake init --template "path:$(realpath "$TEMPLATES_DIR")#${1:-empty}"
    direnv allow
}

function tool:clean {
    # shellcheck source=/dev/null
    source "${XDG_CONFIG_HOME:-$HOME/.config}/direnv/direnvrc"
    local dir
    dir="$(direnv_layout_dir)"
    rm -rf "${dir:?}"
}

function tool:clean-all {
    rm -rf "${CACHE_DIR:?}"
}

function tool:list {
    tools
    templates
}

function tool:help {
    printf "Usage: %s [TOOL [ARGS] | TEMPLATE]\n\nTools:\n" "$0"
    tools | cat -n
    printf "\nTemplates (default: empty):\n"
    templates | cat -n
}

cmd="${1:-init}"
if declare -F "tool:${cmd}" > /dev/null; then
    "tool:${cmd}" "${@:2}"
elif grep -qxF -- "$cmd" <<< "$(templates)"; then
    tool:init "$cmd"
else
    tool:help >&2
    exit 1
fi

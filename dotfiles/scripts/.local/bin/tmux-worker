#!/usr/bin/env bash
#
# tmux-worker: run Claude Code workers in tmux windows, and return the final
# reply of each worker turn to the lead session that started them.
#
# A worker runs in a window of a tmux session, in a folder that the caller
# prepared (usually a git worktree). The window starts the user's interactive
# shell, and spawn types "tmux-worker launch <id>" into it, so the shell hooks
# (direnv) run before claude starts. claude loads the hooks in
# <skill>/scripts/worker-settings.json, which append one JSON line for each
# event to <state>/<id>/turns.jsonl. wait and send read that file.
#
# SC2016: single-quoted $ is intended in jq filters.
# shellcheck disable=SC2016

set -euo pipefail

prog=tmux-worker
state_root="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-worker"
skill_dir="${TMUX_WORKER_SKILL_DIR:-$HOME/.claude/skills/tmux-worker}"

# Set by resolve and spawn.
id=""
dir=""

usage() {
    cat <<'USAGE'
Usage:
  tmux-worker spawn [--name <label>] [--cwd <dir>] [--session <name>]
                    [--session-dir <dir>] [--window <name>] [--model <model>]
                    [--permission-mode <mode>] [--claude-arg <arg>]...
                    <prompt|->
  tmux-worker wait <worker> [--timeout <seconds>]
  tmux-worker send <worker> <message|->
  tmux-worker read <worker> [--lines <n>]
  tmux-worker interrupt <worker>
  tmux-worker stop <worker>
  tmux-worker list [--json] [--lead <session-id>]

<worker> is a worker id, or a name that only one worker has.

spawn creates the tmux session when it is missing (detached, rooted at
--session-dir, which defaults to --cwd) and adds a detached window in --cwd.
Without --session, the window opens in the session of the calling pane.
The permission mode defaults to auto. Each --claude-arg passes one more
argument to claude, for example --claude-arg --chrome. A resume of the worker
passes the same arguments. A worker with --chrome runs without code mode,
because Claude in Chrome does not work in code mode. spawn prints the worker id.

Exit codes of wait and send:
  0    the turn ended (stop)
  1    the turn ended with an API error, or tmux-worker interrupt stopped it
  2    claude or its pane is gone, or the worker is stopped
  3    the worker waits on a permission prompt or a question dialog
  124  --timeout expired
Other: 2 when no tmux server answers, 64 for a usage error or an unknown worker.
USAGE
}

fail() {
    local code=$1
    shift
    printf '%s: %s\n' "$prog" "$*" >&2
    exit "$code"
}

note() {
    printf '%s: %s\n' "$prog" "$*" >&2
}

need_tmux() {
    tmux info >/dev/null 2>&1 || fail 2 "no tmux server answers; start tmux first"
}

meta_get() {
    jq -r "($1) // empty" "$dir/meta.json"
}

meta_true() {
    [ "$(jq -r "($1) == true" "$dir/meta.json")" = true ]
}

meta_update() {
    local tmp
    tmp=$(mktemp "$dir/.meta.XXXXXX")
    jq "$@" "$dir/meta.json" >"$tmp"
    mv "$tmp" "$dir/meta.json"
}

# resolve <id|name>: sets id and dir.
resolve() {
    local arg=${1:-} m matches=() n
    [ -n "$arg" ] || fail 64 "missing worker id"
    if [ -f "$state_root/$arg/meta.json" ]; then
        id=$arg
        dir="$state_root/$id"
        return
    fi
    for m in "$state_root"/*/meta.json; do
        [ -f "$m" ] || continue
        n=$(jq -r --arg name "$arg" 'select(.name == $name) | .id' "$m")
        [ -z "$n" ] || matches+=("$n")
    done
    case ${#matches[@]} in
    0) fail 64 "unknown worker: $arg" ;;
    1)
        id=${matches[0]}
        dir="$state_root/$id"
        ;;
    *) fail 64 "several workers have the name $arg: ${matches[*]}; pass an id" ;;
    esac
}

pane_alive() {
    local pane
    pane=$(meta_get .pane)
    [ -n "$pane" ] && tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1
}

# claude runs, or is about to start, in the worker pane.
claude_running() {
    ! meta_true .stopped && pane_alive && [ ! -f "$dir/claude.exit" ]
}

latest_seq() {
    if [ -s "$dir/turns.jsonl" ]; then
        wc -l <"$dir/turns.jsonl" | tr -d ' '
    else
        echo 0
    fi
}

last_event() {
    [ -s "$dir/turns.jsonl" ] || return 0
    tail -n 1 "$dir/turns.jsonl" | jq -r '.event // empty'
}

# The newest event after seq $1 that ends or pauses a turn. A waiting event
# that a later event follows is stale: the dialog was answered or cancelled.
pending_event() {
    [ -s "$dir/turns.jsonl" ] || return 0
    jq -sc --argjson after "$1" '
        [ .[] | select(.seq > $after) ] as $new
        | ($new | map(select(.event == "stop" or .event == "error" or .event == "waiting" or .event == "interrupted")) | last) as $c
        | if $c == null then empty
          elif $c.event == "waiting" and ($new | any(.seq > $c.seq)) then empty
          else $c end' "$dir/turns.jsonl"
}

target() {
    printf '%s:%s' "$(meta_get .session)" "$(meta_get .window_name)"
}

# Claude Code asks whether to trust a new folder before the first turn, and
# runs no hook for that dialog. Only the screen shows it.
trust_dialog() {
    [ ! -s "$dir/turns.jsonl" ] && claude_running &&
        screen 40 | grep -qF 'trust this folder'
}

report_trust() {
    printf '%s

' "The worker waits on the folder trust dialog of Claude Code. Answer it in the window."
    screen 40
    printf '%s
' "$prog: id=$id target=$(target) pane=$(meta_get .pane) turn=0 event=trust" >&2
    exit 3
}

# Up to $1 lines of the pane, ending at the last line that is not blank.
# Trailing spaces go, and a run of blank lines becomes one blank line.
screen() {
    tmux capture-pane -p -J -t "$(meta_get .pane)" -S "-$1" 2>/dev/null |
        awk '{ sub(/[ \t]+$/, "") } NF || !blank { l[++n] = $0 } { blank = !NF } NF { last = n }
            END { for (i = 1; i <= last; i++) print l[i] }' |
        tail -n "$1"
}

report() {
    local line=$1 seq event text message trailer
    seq=$(jq -r '.seq' <<<"$line")
    event=$(jq -r '.event' <<<"$line")
    text=$(jq -r '.text // ""' <<<"$line")
    message=$(jq -r '.message // "" | gsub("\n"; " ")' <<<"$line")
    meta_update --argjson seq "$seq" '.consumed = $seq'
    trailer="$prog: id=$id target=$(target) pane=$(meta_get .pane) turn=$seq event=$event"
    case $event in
    stop)
        printf '%s\n' "$text"
        printf '%s\n' "$trailer" >&2
        exit 0
        ;;
    error)
        [ -z "$text" ] || printf '%s\n' "$text"
        printf '%s error=%s\n' "$trailer" "$message" >&2
        exit 1
        ;;
    waiting)
        printf '%s\n\n' "${message:-The worker waits on a dialog.}"
        ! pane_alive || screen 40
        printf '%s\n' "$trailer" >&2
        exit 3
        ;;
    interrupted)
        printf '%s\n' "The turn was interrupted."
        printf '%s\n' "$trailer" >&2
        exit 1
        ;;
    esac
}

report_gone() {
    if meta_true .stopped; then
        fail 2 "id=$id the worker is stopped; send a message to resume it"
    fi
    if pane_alive; then
        screen 40
        fail 2 "id=$id target=$(target) claude exited with status $(cat "$dir/claude.exit" 2>/dev/null || echo '?') without a new turn"
    fi
    fail 2 "id=$id target=$(target) the pane is gone without a new turn"
}

# wait_event <after-seq> [timeout-seconds]
wait_event() {
    local after=$1 timeout=${2:-} start=$SECONDS line
    while :; do
        line=$(pending_event "$after")
        [ -z "$line" ] || report "$line"
        ! trust_dialog || report_trust
        if ! claude_running; then
            # The Stop hook can write its line just before claude exits.
            line=$(pending_event "$after")
            [ -z "$line" ] || report "$line"
            report_gone
        fi
        if [ -n "$timeout" ] && [ $((SECONDS - start)) -ge "$timeout" ]; then
            fail 124 "id=$id target=$(target) timed out after ${timeout}s without a new turn"
        fi
        sleep 1
    done
}

# tmux reads "." and ":" in a session name as target syntax and replaces them.
session_name() {
    printf '%s' "$1" | tr '.:' '__'
}

real_dir() {
    (cd "$1" 2>/dev/null && pwd -P) || fail 64 "no such folder: $1"
}

ensure_session() {
    local session=$1 root=$2 path
    if ! tmux has-session -t "=$session" 2>/dev/null; then
        tmux new-session -d -s "$session" -c "$root"
        return
    fi
    path=$(tmux display-message -p -t "=$session:" '#{session_path}')
    if [ "$(real_dir "$path" 2>/dev/null || echo "$path")" != "$root" ]; then
        note "session $session exists with the root $path, not $root; the window goes there"
    fi
}

# A window name that the session does not use yet: name, name-2, name-3, ...
free_window_name() {
    local session=$1 base=$2 name=$2 n=2
    while tmux list-windows -t "=$session" -F '#{window_name}' 2>/dev/null | grep -Fxq -- "$name"; do
        name="$base-$n"
        n=$((n + 1))
    done
    printf '%s' "$name"
}

open_window() {
    local session root cwd win out wid pane
    session=$(meta_get .session)
    root=$(meta_get .session_dir)
    cwd=$(meta_get .cwd)
    ensure_session "$session" "$root"
    win=$(free_window_name "$session" "$(meta_get .window_base)")
    out=$(tmux new-window -d -t "=$session:" -n "$win" -c "$cwd" -P -F '#{window_id} #{pane_id}')
    wid=${out% *}
    pane=${out#* }
    # The tmux-window-name plugin renames every window whose
    # @tmux_window_name_enabled is not 0. Set the name again in case it ran.
    tmux set-option -w -t "$wid" automatic-rename off
    tmux set-option -w -t "$wid" @tmux_window_name_enabled 0
    tmux rename-window -t "$wid" "$win"
    tmux set-option -p -t "$pane" @tmux_worker_id "$id"
    meta_update --arg win "$win" --arg wid "$wid" --arg pane "$pane" \
        '.window_name = $win | .window_id = $wid | .pane = $pane | .stopped = false'
}

# Types the launch command into the shell of the worker pane.
type_launch() {
    rm -f "$dir/claude.exit"
    tmux send-keys -t "$(meta_get .pane)" -l "tmux-worker launch $id"
    tmux send-keys -t "$(meta_get .pane)" Enter
}

paste_message() {
    local pane buffer="tmux-worker-$id"
    pane=$(meta_get .pane)
    printf '%s' "$1" >"$dir/message.txt"
    tmux load-buffer -b "$buffer" "$dir/message.txt"
    # -p: bracketed paste keeps multi-line text as one input.
    # -r: keep LF; a CR would submit each line when bracketed paste is off.
    tmux paste-buffer -p -r -d -b "$buffer" -t "$pane"
    sleep 0.3
    tmux send-keys -t "$pane" Enter
}

new_id() {
    local candidate
    while :; do
        candidate=$(od -An -N3 -tx1 /dev/urandom | tr -d ' \n')
        [ -e "$state_root/$candidate" ] || break
    done
    printf '%s' "$candidate"
}

read_text() {
    if [ "$1" = - ]; then
        cat
    else
        printf '%s' "$1"
    fi
}

# tmux-worker sets these claude options itself, at each launch and resume.
check_claude_arg() {
    case ${1%%=*} in
    --settings | -n | --name | --permission-mode | --model | --session-id | \
        -r | --resume | -c | --continue | --fork-session | -p | --print | --)
        fail 64 "--claude-arg $1: tmux-worker sets this option; use the spawn option instead" ;;
    esac
    case $1 in
    *$'\n'*) fail 64 "--claude-arg: a value cannot hold a line break" ;;
    esac
}

cmd_spawn() {
    local name="" cwd=$PWD session="" session_dir="" window="" model=""
    local mode=auto prompt_arg="" prompt uuid extra='[]'
    local claude_args=()
    while [ $# -gt 0 ]; do
        case $1 in
        --name) name=${2:?--name needs a value}; shift 2 ;;
        --cwd) cwd=${2:?--cwd needs a value}; shift 2 ;;
        --session) session=${2:?--session needs a value}; shift 2 ;;
        --session-dir) session_dir=${2:?--session-dir needs a value}; shift 2 ;;
        --window) window=${2:?--window needs a value}; shift 2 ;;
        --model) model=${2:?--model needs a value}; shift 2 ;;
        --permission-mode) mode=${2:?--permission-mode needs a value}; shift 2 ;;
        --claude-arg)
            [ $# -ge 2 ] || fail 64 "--claude-arg needs a value"
            check_claude_arg "$2"
            claude_args+=("$2")
            shift 2
            ;;
        -h | --help) usage; exit 0 ;;
        -) prompt_arg=-; shift ;;
        -*) fail 64 "unknown option: $1" ;;
        *)
            [ -z "$prompt_arg" ] || fail 64 "give one prompt"
            prompt_arg=$1
            shift
            ;;
        esac
    done
    [ -n "$prompt_arg" ] || fail 64 "missing prompt (pass - to read it from stdin)"
    # A worker that starts workers would hide work from the lead and the user.
    [ -z "${TMUX_WORKER_ID:-}" ] || fail 64 "a tmux worker cannot start workers"
    need_tmux
    [ -f "$skill_dir/scripts/worker-settings.json" ] ||
        fail 2 "missing $skill_dir/scripts/worker-settings.json (set TMUX_WORKER_SKILL_DIR)"
    command -v claude >/dev/null 2>&1 || fail 2 "claude is not on PATH"

    cwd=$(real_dir "$cwd")
    if [ -n "$session" ]; then
        session=$(session_name "$session")
        session_dir=$(real_dir "${session_dir:-$cwd}")
    else
        [ -n "${TMUX_PANE:-}" ] || fail 64 "outside a tmux pane; pass --session"
        session=$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}')
        session_dir=$(tmux display-message -p -t "$TMUX_PANE" '#{session_path}')
    fi
    [ -n "$name" ] || name=$(basename "$cwd")
    [ -n "$window" ] || window=$(basename "$cwd")
    prompt=$(read_text "$prompt_arg")
    [ -n "$prompt" ] || fail 64 "the prompt is empty"

    mkdir -p "$state_root"
    id=$(new_id)
    dir="$state_root/$id"
    mkdir -p "$dir"
    printf '%s' "$prompt" >"$dir/prompt.md"
    uuid=$(uuidgen | tr '[:upper:]' '[:lower:]')
    if [ ${#claude_args[@]} -gt 0 ]; then
        extra=$(printf '%s\n' "${claude_args[@]}" | jq -R . | jq -sc .)
    fi
    jq -n --arg id "$id" --arg name "$name" --arg cwd "$cwd" \
        --arg session "$session" --arg session_dir "$session_dir" \
        --arg window "$window" --arg uuid "$uuid" \
        --arg lead "${CLAUDE_CODE_SESSION_ID:-}" --arg lead_pane "${TMUX_PANE:-}" \
        --arg model "$model" --arg mode "$mode" --arg skill_dir "$skill_dir" \
        --argjson now "$(date +%s)" --argjson claude_args "$extra" \
        '{id: $id, name: $name, cwd: $cwd, session: $session, session_dir: $session_dir,
          window_base: $window, window_name: $window, window_id: "", pane: "",
          claude_session: $uuid, lead_session: $lead, lead_pane: $lead_pane,
          model: $model, permission_mode: $mode, claude_args: $claude_args,
          skill_dir: $skill_dir, consumed: 0, launched: false, stopped: false, created: $now}' >"$dir/meta.json"
    open_window
    type_launch
    printf '%s\n' "$id"
    note "id=$id target=$(target) pane=$(meta_get .pane) cwd=$cwd"
}

cmd_launch() {
    resolve "${1:-}"
    local args=() extra=() status settings session
    # The shell of the worker pane does not have the environment of spawn.
    skill_dir=$(meta_get .skill_dir)
    skill_dir=${skill_dir:-$HOME/.claude/skills/tmux-worker}
    settings="$skill_dir/scripts/worker-settings.json"
    [ -f "$settings" ] || fail 2 "missing $settings"
    export TMUX_WORKER_ID="$id" TMUX_WORKER_DIR="$dir"
    export TMUX_WORKER_HOOK="$skill_dir/scripts/turn-signal.sh"
    # Variables of an outer Claude session make claude act as its child and
    # ignore --session-id. A tmux shell does not have them, but a shell that a
    # Claude session started does.
    unset CLAUDECODE CLAUDE_CODE_SESSION_ID CLAUDE_CODE_CHILD_SESSION \
        CLAUDE_CODE_ENTRYPOINT CLAUDE_CODE_MESSAGING_SOCKET \
        CLAUDE_CODE_MESSAGING_TOKEN CLAUDE_PID CLAUDE_CODE_SESSION_ATTENDED
    args=(--settings "$settings" -n "$(meta_get .name)" --permission-mode "$(meta_get .permission_mode)")
    [ -z "$(meta_get .model)" ] || args+=(--model "$(meta_get .model)")
    mapfile -t extra < <(jq -r '.claude_args // [] | .[]' "$dir/meta.json")
    args+=("${extra[@]}")
    # Claude in Chrome does not work in code mode, which the environment can
    # turn on for every session. A worker with --chrome runs without code mode,
    # at each resume too: a session resumes only in the mode it started in.
    if printf '%s\n' "${extra[@]}" | grep -qx -- --chrome; then
        export CLAUDE_CODE_EXPERIMENTAL_CODE_MODE=0
    fi
    if meta_true .launched; then
        # The hooks record the session id that claude really uses.
        session=$(jq -rs 'map(.session_id // empty | select(length > 0)) | last // empty' "$dir/turns.jsonl" 2>/dev/null || true)
        args+=(--resume "${session:-$(meta_get .claude_session)}")
    else
        args+=(--session-id "$(meta_get .claude_session)")
    fi
    meta_update '.launched = true'
    rm -f "$dir/claude.exit"
    cd "$(meta_get .cwd)"
    set +e
    claude "${args[@]}" -- "$(cat "$dir/prompt.md")"
    status=$?
    set -e
    printf '%s\n' "$status" >"$dir/claude.exit"
}

cmd_wait() {
    resolve "${1:-}"
    shift || true
    local timeout=""
    while [ $# -gt 0 ]; do
        case $1 in
        --timeout) timeout=${2:?--timeout needs a value}; shift 2 ;;
        *) fail 64 "unknown argument: $1" ;;
        esac
    done
    wait_event "$(meta_get .consumed)" "$timeout"
}

cmd_send() {
    resolve "${1:-}"
    local message after
    [ $# -ge 2 ] || fail 64 "missing message (pass - to read it from stdin)"
    message=$(read_text "$2")
    [ -n "$message" ] || fail 64 "the message is empty"
    need_tmux
    after=$(latest_seq)
    if claude_running; then
        # Pasted text would answer the dialog.
        if [ "$(last_event)" = waiting ] || trust_dialog; then
            fail 3 "id=$id target=$(target) the worker waits on a dialog; it must be answered in its window first"
        fi
        paste_message "$message"
    else
        printf '%s' "$message" >"$dir/prompt.md"
        if meta_true .stopped || ! pane_alive; then
            open_window
        fi
        type_launch
        note "id=$id target=$(target) reopened the worker with --resume"
    fi
    wait_event "$after"
}

cmd_read() {
    resolve "${1:-}"
    shift || true
    local lines=60
    while [ $# -gt 0 ]; do
        case $1 in
        --lines) lines=${2:?--lines needs a value}; shift 2 ;;
        *) fail 64 "unknown argument: $1" ;;
        esac
    done
    pane_alive || fail 2 "id=$id the pane is gone"
    screen "$lines"
}

cmd_interrupt() {
    resolve "${1:-}"
    local hook pane shot
    pane_alive || fail 2 "id=$id the pane is gone"
    pane=$(meta_get .pane)
    case $(last_event) in
    waiting)
        # Escape cancels a dialog in every editor mode.
        tmux send-keys -t "$pane" Escape
        ;;
    working)
        # Ctrl+C stops the turn. With the vim editor mode on, Escape only
        # leaves insert mode, and the turn goes on.
        tmux send-keys -t "$pane" C-c
        sleep 1
        # A turn stopped before its first output puts its prompt back in the
        # input, and the next send would add to it. A second Ctrl+C clears the
        # input. On an empty input, a second Ctrl+C arms the exit of claude, so
        # send it only while the input row has text and no exit hint shows.
        shot=$(tmux capture-pane -p -t "$pane")
        if ! grep -qi 'again to exit' <<<"$shot" &&
            grep '^❯' <<<"$shot" | tail -n 1 | grep -q '^❯[[:space:]]*[^[:space:]]'; then
            tmux send-keys -t "$pane" C-c
        fi
        ;;
    *)
        note "id=$id no turn runs; nothing to interrupt"
        return 0
        ;;
    esac
    # Claude Code runs no hook for an interrupt. Record it, so that wait
    # returns and send no longer sees an open dialog.
    hook="$(meta_get .skill_dir)/scripts/turn-signal.sh"
    TMUX_WORKER_DIR="$dir" bash "$hook" interrupted </dev/null
}

cmd_stop() {
    resolve "${1:-}"
    local wid
    wid=$(meta_get .window_id)
    # The worktree, the branch, the session, and the state stay.
    [ -z "$wid" ] || tmux kill-window -t "$wid" 2>/dev/null || true
    meta_update '.stopped = true'
}

cmd_list() {
    local json=false lead="" m d alive exited trust turns panes="" records metas
    while [ $# -gt 0 ]; do
        case $1 in
        --json) json=true; shift ;;
        --lead)
            [ $# -ge 2 ] || fail 64 "--lead needs a session id"
            lead=$2
            shift 2
            ;;
        *) fail 64 "unknown argument: $1" ;;
        esac
    done
    # One grep skips the workers of other leads before jq runs for each worker.
    # The plugin runs this list every few seconds in each Claude session.
    if [ -n "$lead" ]; then
        metas=$(grep -lF -- "$lead" "$state_root"/*/meta.json 2>/dev/null || true)
    else
        metas=$(printf '%s\n' "$state_root"/*/meta.json)
    fi
    if tmux info >/dev/null 2>&1; then
        panes=$(tmux list-panes -a -F '#{pane_id}')
    fi
    records=$(
        while IFS= read -r m; do
            [ -f "$m" ] || continue
            d=$(dirname "$m")
            alive=false
            if grep -Fxq -- "$(jq -r '.pane' "$m")" <<<"$panes"; then
                alive=true
            fi
            exited=false
            [ ! -f "$d/claude.exit" ] || exited=true
            turns="$d/turns.jsonl"
            [ -s "$turns" ] || turns=/dev/null
            # Before its first turn event, a worker can wait on the folder
            # trust dialog, which runs no hook.
            trust=false
            if [ "$turns" = /dev/null ] && $alive && ! $exited &&
                tmux capture-pane -p -t "$(jq -r '.pane' "$m")" 2>/dev/null | grep -qF 'trust this folder'; then
                trust=true
            fi
            jq -n --slurpfile m "$m" --slurpfile t "$turns" \
                --argjson alive "$alive" --argjson exited "$exited" --argjson trust "$trust" '
                $m[0] as $m
                | ($t | last) as $last
                | ($t | map(select(.event == "stop")) | last) as $stop
                | {
                    id: $m.id, name: $m.name, lead_session: $m.lead_session,
                    session: $m.session, window: $m.window_name, window_id: $m.window_id,
                    pane: $m.pane, target: ($m.session + ":" + $m.window_name), cwd: $m.cwd,
                    status: (if $m.stopped then "stopped"
                             elif ($alive | not) or $exited then "dead"
                             elif $trust then "waiting"
                             else ({stop: "idle", interrupted: "idle", error: "error", waiting: "waiting"}[$last.event // ""] // "working")
                             end),
                    since: ($last.ts // $m.created),
                    turn: ($t | map(select(.event != "working")) | last | .seq // 0),
                    last_text: (($stop.text // "") | split("\n") | map(select(test("\\S"))) | first // "" | .[0:200]),
                    created: $m.created
                  }'
        done <<<"$metas"
    )
    if $json; then
        jq -s --arg lead "$lead" 'map(select($lead == "" or .lead_session == $lead)) | sort_by(.created)' <<<"$records"
    else
        jq -rs --arg lead "$lead" 'map(select($lead == "" or .lead_session == $lead)) | sort_by(.created)[] | [.id, .name, .status, .target, .cwd] | @tsv' <<<"$records" |
            column -t -s "$(printf '\t')"
    fi
}

main() {
    local command=${1:-}
    [ $# -eq 0 ] || shift
    case $command in
    spawn) cmd_spawn "$@" ;;
    launch) cmd_launch "$@" ;;
    wait) cmd_wait "$@" ;;
    send) cmd_send "$@" ;;
    read) cmd_read "$@" ;;
    interrupt) cmd_interrupt "$@" ;;
    stop) cmd_stop "$@" ;;
    list) cmd_list "$@" ;;
    -h | --help | help) usage ;;
    "") usage >&2; exit 64 ;;
    *) fail 64 "unknown command: $command" ;;
    esac
}

main "$@"

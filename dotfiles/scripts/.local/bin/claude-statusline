#!/usr/bin/env bash
# Claude Code statusline renderer.
#
# Layout (single line, dim scaffolding with colored values):
#   project  model  effort  C ctx-bar pct used/total   <flex>
#   ↑in ↓out Rread Wwrite $cost  S session-bar pct reset  W weekly-bar pct reset
#
# Bars are 8 cells of eighth-block sub-cell fill (64 steps) over a painted
# track. Every unused cell is bare backing (TRACK_BG) -- the plain track, the
# unfilled remainder of the partial boundary cell, and the pace tick's cell --
# so the whole unused stretch reads as one flat shade. The C bar colors by
# absolute fill (green < 60 <= yellow < 85 <= red). S/W bars mark pace with
# a thin ▏ tick at the elapsed fraction of their reset window (drawn on the
# bar color inside the fill, on the track backing outside it) and color by
# used% - elapsed% (green on/behind pace, yellow/red ahead); with no
# resets_at they fall back to absolute fill colors and no tick.
# On overflow the C bar collapses
# to its text form, then the project name drops, then the line truncates
# with "...".
#
# All data comes from the statusline stdin JSON plus one jq pass over the
# transcript. No network or Keychain access: when rate_limits is absent the
# usage widgets are omitted.
set -euo pipefail

# Char-based ${#} / ${s:i:1} for the multibyte bar glyphs. C.UTF-8 exists on
# both darwin and glibc/nix hosts.
export LC_ALL=C.UTF-8

ESC=$'\033'
NBSP=$'\302\240'
input=$(cat)

# ---------------------------------------------------------------- stdin parse
# One jq call -> unit-separator-joined fields (tabs would collapse on empty
# fields under IFS splitting). Empty field = widget omitted.
IFS=$'\037' read -r model effort_state cost ctx_used ctx_total \
  fh_pct fh_reset sd_pct sd_reset transcript cw_in cw_out project_raw < <(
    jq -r '
    def num_or_empty: if type == "number" then . else "" end;
    def nn: if type == "number" and . >= 0 then . else 0 end;
    . as $d
    | ($d.context_window? // null) as $cw
    | (if ($cw | type) == "object" then $cw else null end) as $cw
    | (try (if ($cw.context_window_size | type) == "number" and $cw.context_window_size > 0
            then $cw.context_window_size else "" end) catch "") as $total
    | (try (
        if ($cw.current_usage | type) == "object" then
          (($cw.current_usage.input_tokens | nn)
           + ($cw.current_usage.cache_creation_input_tokens | nn)
           + ($cw.current_usage.cache_read_input_tokens | nn))
        elif ($cw.current_usage | type) == "number" then $cw.current_usage
        elif ($cw.used_percentage | type) == "number" and $total != "" then
          ($cw.used_percentage | if . < 0 then 0 else . end) / 100 * $total
        else "" end) catch "") as $used
    | [
        (if ($d.model | type) == "string" then $d.model
         elif ($d.model | type) == "object" then ($d.model.display_name // $d.model.id // "")
         else "" end
         | if . == "" then "" else sub("\\s*\\(.*\\)$"; "") end),
        (if ($d | has("effort")) and (($d.effort | type) == "object") and ($d.effort | has("level"))
         then (if ($d.effort.level | type) == "string" then "L\($d.effort.level)" else "default" end)
         else "fallback" end),
        (try ($d.cost.total_cost_usd | num_or_empty) catch ""),
        $used, $total,
        (try ($d.rate_limits.five_hour.used_percentage | num_or_empty) catch ""),
        (try ($d.rate_limits.five_hour.resets_at | num_or_empty) catch ""),
        (try ($d.rate_limits.seven_day.used_percentage | num_or_empty) catch ""),
        (try ($d.rate_limits.seven_day.resets_at | num_or_empty) catch ""),
        ($d.transcript_path? // "" | if type == "string" then . else "" end),
        (try ($cw.total_input_tokens | num_or_empty) catch ""),
        (try ($cw.total_output_tokens | num_or_empty) catch ""),
        ([(try $d.workspace.project_dir catch null),
          (try $d.workspace.current_dir catch null), $d.cwd?]
         | map(select(type == "string" and . != "")) | first // "")
      ]
    | map(tostring) | join("\u001f")' <<<"$input"
  )

# ------------------------------------------------------- transcript token sums
# Sums entries with message.usage, one row per API response. A multi-block
# assistant message (text + thinking + each tool_use) is written as one line
# per block, every line repeating the same message.id and the same usage
# object, so summing raw lines double- or triple-counts most turns -- dedup on
# that id. Entries without one can't be grouped and fall back to their line
# index, keeping them distinct rather than collapsing them into a single row.
#
# ↑input is the API's input_tokens: the cache-miss slice only, routinely 1-2
# tokens a turn. The rest of the prompt lands in Rcache-read/Wcache-write, so
# the three together are the real input.
tok_in='' tok_out='' tok_read='' tok_write=''
if [[ -n $transcript ]]; then
  tok_in=0 tok_out=0 tok_read=0 tok_write=0
  if [[ -r $transcript ]]; then
    IFS=$'\t' read -r tok_in tok_out tok_read tok_write < <(
      jq -rnR '
        [inputs | fromjson? | select(type == "object")
         | select((.message? | type) == "object" and (.message.usage | type) == "object")]
        | to_entries
        | group_by(.value.message.id // "\(.key)")
        | map(.[0].value.message.usage) as $u
        | [($u | map(.input_tokens? // 0) | add // 0),
           ($u | map(.output_tokens? // 0) | add // 0),
           ($u | map(.cache_read_input_tokens? // 0) | add // 0),
           ($u | map(.cache_creation_input_tokens? // 0) | add // 0)]
        | @tsv' "$transcript" 2>/dev/null
    ) || { tok_in=0 tok_out=0 tok_read=0 tok_write=0; }
  fi
fi

# ------------------------------------------------------------------ formatters
printf -v now '%(%s)T' -1

# One awk pass for everything float-shaped, mirroring the JS rounding exactly:
# jsround      = Math.round for non-negative values (ties away from zero);
# tofixed1     = toFixed(1): printf %.1f rounds the double half-to-even, JS
#                half-away; they only disagree when the double is exactly x.25
#                (the sole dyadic 1-decimal midpoint where even != away, since
#                x.75 rounds to x.8 either way);
# fmt_tokens   = token count display (>=1M -> X.XM, >=1000 -> X.Xk).
# Each bar emits as: full cells, partial-glyph eighth (0-7), tick cell (S/W,
# '' when resets_at is unknown), ANSI color code, rounded pct, and clamped
# reset-countdown seconds (S/W).
IFS=$'\037' read -r cost_text t_in t_out t_read t_write t_cwin t_cwout \
  ctx_full ctx_part ctx_color ctx_pct ctx_used_f ctx_total_f \
  fh_full fh_part fh_tick fh_color fh_pct1 fh_rem \
  sd_full sd_part sd_tick sd_color sd_pct1 sd_rem < <(
    awk -v cost="$cost" -v ti="$tok_in" -v to="$tok_out" \
      -v trd="$tok_read" -v twr="$tok_write" \
      -v cwi="$cw_in" -v cwo="$cw_out" -v cu="$ctx_used" -v ct="$ctx_total" \
      -v fp="$fh_pct" -v fr="$fh_reset" -v sp="$sd_pct" -v sr="$sd_reset" \
      -v now="$now" '
    function jsround(v, n) { n = int(v); return (v - n >= 0.5) ? n + 1 : n }
    function tofixed1(v, f) {
      f = v - int(v)
      if (f == 0.25) return sprintf("%d.3", int(v))
      return sprintf("%.1f", v)
    }
    function fmt_tokens(c, d) {
      if (c >= 1000000 - 500 / (10 ^ d)) return tofixed1(c / 1000000) "M"
      if (c < 1000) return sprintf("%d", c)
      if (d == 0) return jsround(c / 1000) "k"
      return tofixed1(c / 1000) "k"
    }
    function clamp100(v) { return (v < 0) ? 0 : ((v > 100) ? 100 : v) }
    function abs_color(p) { return (p >= ABS_RED) ? 31 : ((p >= ABS_YEL) ? 33 : 32) }
    # usage_bar: B_FULL/B_PART = 64-step fill split into whole cells and a
    # partial-glyph eighth; when the reset time is known B_TICK marks the
    # elapsed-time cell and B_COL follows used% - elapsed% pace, otherwise no
    # tick and absolute fill color; B_REM = countdown clamped to [0, win].
    function usage_bar(p, reset, win,    rem, steps, elapsed, delta) {
      B_FULL = B_PART = B_TICK = B_COL = B_PCT = B_REM = ""
      if (reset != "") {
        rem = reset - now
        if (rem < 0) rem = 0
        if (rem > win) rem = win
        B_REM = int(rem)
      }
      if (p == "") return
      p = clamp100(p)
      steps = jsround(p / 100 * 64)
      B_FULL = int(steps / 8)
      B_PART = steps % 8
      B_PCT = jsround(p)
      if (reset == "") {
        B_COL = abs_color(p)
        return
      }
      elapsed = (win - B_REM) / win * 100
      B_TICK = jsround(elapsed / 100 * 8)
      if (B_TICK > 7) B_TICK = 7
      delta = p - elapsed
      B_COL = (delta > PACE_RED) ? 31 : ((delta > PACE_YEL) ? 33 : 32)
    }
    BEGIN {
      OFS = "\037"
      ABS_YEL = 60; ABS_RED = 85      # absolute fill thresholds, pct
      PACE_YEL = 5; PACE_RED = 15     # used% - elapsed% pace deltas
      FH_WIN = 18000; SD_WIN = 604800 # rate-limit windows, seconds
      cost_text = (cost == "") ? "" : sprintf("$%.2f", cost)
      t_in = (ti == "") ? "" : fmt_tokens(ti, 1)
      t_out = (to == "") ? "" : fmt_tokens(to, 1)
      t_read = (trd == "") ? "" : fmt_tokens(trd, 1)
      t_write = (twr == "") ? "" : fmt_tokens(twr, 1)
      t_cwin = (cwi == "") ? "" : fmt_tokens(cwi, 1)
      t_cwout = (cwo == "") ? "" : fmt_tokens(cwo, 1)
      cfull = cpart = ccol = cp = cuf = ctf = ""
      if (cu != "" && ct != "") {
        p = clamp100(cu / ct * 100)
        steps = jsround(p / 100 * 64)
        cfull = int(steps / 8); cpart = steps % 8
        ccol = abs_color(p); cp = jsround(p)
        cuf = fmt_tokens(cu, 0); ctf = fmt_tokens(ct, 0)
      }
      usage_bar(fp, fr, FH_WIN)
      ff = B_FULL; fpart = B_PART; ftick = B_TICK; fcol = B_COL; f1 = B_PCT; frem = B_REM
      usage_bar(sp, sr, SD_WIN)
      sf = B_FULL; spart = B_PART; stick = B_TICK; scol = B_COL; s1 = B_PCT; srem = B_REM
      print cost_text, t_in, t_out, t_read, t_write, t_cwin, t_cwout,
        cfull, cpart, ccol, cp, cuf, ctf,
        ff, fpart, ftick, fcol, f1, frem,
        sf, spart, stick, scol, s1, srem
    }'
  )

# Backing for every unused bar cell, drawn bare. No ░ dither over it: a cell
# carrying one always reads lighter than the two cells that can't take one --
# the pace tick's, and the unfilled remainder of the partial boundary cell,
# both of which show backing alone -- and there is no right-aligned partial
# block glyph to fix that. Flat is the only uniform option.
#
# Bright black: a palette slot, so it follows the theme. It is also the only
# palette shade lighter than the terminal background -- the 16 colors put black
# at or near the background itself and offer nothing between the two. For a
# shade in that gap, a 256-color gray does it at the cost of following the
# theme: '48;5;237' (#3a3a3a) sits one step above a typical dark background.
TRACK_BG=100

mkbar() { # full partial-eighth tick-cell color -> BAR (8 visible cells)
  local full=$1 part=$2 tick=$3 color=$4 i sgr glyph cur=''
  local partials='▏▎▍▌▋▊▉'
  BAR=''
  for ((i = 0; i < 8; i++)); do
    if ((i < full)); then # filled cell: solid block, no background needed
      sgr="${color};49" glyph='█'
    elif ((i == full && part > 0)); then # boundary cell: partial eighth-block
      sgr="${color};${TRACK_BG}" glyph=${partials:part-1:1}
    else # unused cell: bare backing
      sgr="39;${TRACK_BG}" glyph=' '
    fi
    if [[ -n $tick ]] && ((i == tick)); then
      # thin pace tick, painted over whatever cell it lands on: bar color
      # inside the fill, the same backing as the unused cells on the track
      if ((i < full || (i == full && part >= 4))); then
        sgr="39;$((color + 10))"
      else
        sgr="39;${TRACK_BG}"
      fi
      glyph='▏'
    fi
    if [[ $sgr != "$cur" ]]; then
      BAR+="${ESC}[${sgr}m"
      cur=$sgr
    fi
    BAR+=$glyph
  done
  BAR+="${ESC}[49m" # drop the backing before the caller's next text
}

fmt_duration() { # seconds -> DUR, compact "XdYhZm" ("0m" floor, zero parts skipped)
  local secs=$1 th d h m
  ((secs < 0)) && secs=0
  th=$((secs / 3600))
  m=$(((secs % 3600) / 60))
  d=$((th / 24))
  h=$((th % 24))
  DUR=''
  ((d > 0)) && DUR+="${d}d"
  ((h > 0)) && DUR+="${h}h"
  ((m > 0)) && DUR+="${m}m"
  DUR=${DUR:-0m}
}

# ------------------------------------------------------------- widget assembly
# Each element renders as: reset-padded space, colored text, reset-padded space.
# Visible width = text chars + 2. Multi-color segments pass pre-escaped text
# with a hand-computed visible length.
left='' right='' left_len=0 right_len=0

mk_el() { # color-code text -> EL
  EL="${ESC}[0m ${ESC}[0m${ESC}[$1m$2${ESC}[39m${ESC}[0m ${ESC}[0m"
}
add_left() { # color-code text text-visible-chars
  mk_el "$1" "$2"
  left+=$EL
  left_len=$((left_len + $3 + 2))
}
add_right() {
  mk_el "$1" "$2"
  right+=$EL
  right_len=$((right_len + $3 + 2))
}

# project (cyan, basename of workspace.project_dir > .current_dir > cwd).
# Kept out of `left` so the overflow path below can drop it independently.
proj_el='' proj_len=0
project=${project_raw%/}
project=${project##*/}
if [[ -n $project ]]; then
  mk_el 36 "$project"
  proj_el=$EL proj_len=$((${#project} + 2))
fi

# model (blue, raw)
[[ -n $model ]] && add_left 34 "$model" ${#model}

# thinking-effort (magenta, raw)
normalize_effort() {
  local v=${1,,}
  case $v in
    low | medium | high | xhigh | max) printf '%s' "$v" && return ;;
  esac
  if [[ $v =~ ^[a-z0-9-]{2,20}$ && $v == *[a-z0-9]* ]]; then printf '%s?' "$v"; fi
}
effort=''
case $effort_state in
  L*) effort=$(normalize_effort "${effort_state#L}") ;;
  default) effort=default ;;
esac
if [[ -z $effort ]]; then # stdin had no usable effort: fall back to settings
  effort=$(normalize_effort "$(jq -r '.effortLevel // empty' "$HOME/.claude/settings.json" 2>/dev/null)")
  effort=${effort:-default}
fi
add_left 35 "$effort" ${#effort}

# context bar (dim "C" label, bar/pct/"%"/used-value in the bar color, dim
# "/total"). Last element of the left cluster but kept out of `left` so
# the overflow path below can swap in the bar-less text-only variant.
ctx_el='' ctx_el_len=0 ctx_min_el='' ctx_min_el_len=0
if [[ -n $ctx_color ]]; then
  mkbar "$ctx_full" "$ctx_part" '' "$ctx_color"
  ctx_text="${ESC}[90mC $BAR ${ESC}[${ctx_color}m${ctx_pct}% $ctx_used_f${ESC}[90m/$ctx_total_f"
  mk_el 39 "$ctx_text"
  ctx_el=$EL ctx_el_len=$((14 + ${#ctx_pct} + ${#ctx_used_f} + ${#ctx_total_f} + 2))
  ctx_text="${ESC}[90mC ${ESC}[${ctx_color}m${ctx_pct}% $ctx_used_f${ESC}[90m/$ctx_total_f"
  mk_el 39 "$ctx_text"
  ctx_min_el=$EL ctx_min_el_len=$((5 + ${#ctx_pct} + ${#ctx_used_f} + ${#ctx_total_f} + 2))
fi

# tokens + cost as one single-spaced group, first element of the right
# cluster: ↑input ↓output Rcache-read Wcache-write $cost. ↑ cyan, ↓ green,
# R/W dim prefixes with default-color values, cost yellow. With no
# transcript_path, fall back to context_window totals for ↑/↓ and omit R/W.
seg='' seg_len=0
if [[ -n $t_in ]]; then
  seg="${ESC}[36m↑$t_in ${ESC}[32m↓$t_out ${ESC}[90mR${ESC}[39m$t_read ${ESC}[90mW${ESC}[39m$t_write"
  seg_len=$((7 + ${#t_in} + ${#t_out} + ${#t_read} + ${#t_write}))
else
  if [[ -n $t_cwin ]]; then
    seg="${ESC}[36m↑$t_cwin"
    seg_len=$((1 + ${#t_cwin}))
  fi
  if [[ -n $t_cwout ]]; then
    seg+="${seg:+ }${ESC}[32m↓$t_cwout"
    seg_len=$((seg_len + (seg_len > 0 ? 1 : 0) + 1 + ${#t_cwout}))
  fi
fi
if [[ -n $seg && -n $cost_text ]]; then
  add_right 39 "$seg ${ESC}[33m$cost_text" $((seg_len + 1 + ${#cost_text}))
elif [[ -n $seg ]]; then
  add_right 39 "$seg" "$seg_len"
elif [[ -n $cost_text ]]; then
  add_right 33 "$cost_text" ${#cost_text}
fi

# session-usage (dim "S" label, five_hour bar, pct/"%" in the bar color, dim
# countdown attached)
fh_dur=''
if [[ -n $fh_rem ]]; then
  fmt_duration "$fh_rem"
  fh_dur=$DUR
fi
if [[ -n $fh_color ]]; then
  mkbar "$fh_full" "$fh_part" "$fh_tick" "$fh_color"
  s_text="${ESC}[90mS $BAR ${ESC}[${fh_color}m${fh_pct1}%${fh_dur:+ ${ESC}[90m$fh_dur}"
  add_right 39 "$s_text" $((12 + ${#fh_pct1} + (${#fh_dur} > 0 ? 1 + ${#fh_dur} : 0)))
elif [[ -n $fh_dur ]]; then
  add_right 90 "$fh_dur" ${#fh_dur}
fi

# weekly-usage (dim "W" label, seven_day bar, pct/"%" in the bar color, dim
# countdown attached)
sd_dur=''
if [[ -n $sd_rem ]]; then
  fmt_duration "$sd_rem"
  sd_dur=$DUR
fi
if [[ -n $sd_color ]]; then
  mkbar "$sd_full" "$sd_part" "$sd_tick" "$sd_color"
  w_text="${ESC}[90mW $BAR ${ESC}[${sd_color}m${sd_pct1}%${sd_dur:+ ${ESC}[90m$sd_dur}"
  add_right 39 "$w_text" $((12 + ${#sd_pct1} + (${#sd_dur} > 0 ? 1 + ${#sd_dur} : 0)))
elif [[ -n $sd_dur ]]; then
  add_right 90 "$sd_dur" ${#sd_dur}
fi

[[ -z $proj_el && -z $left && -z $ctx_el && -z $right ]] && exit 0

# -------------------------------------------------------------- width & flex
probe_width() { # -> WIDTH ('' when undetectable): env override, tty walk, tput
  local w pid ppid tty
  WIDTH=''
  w=${CLAUDE_STATUSLINE_WIDTH:-}
  if [[ $w =~ ^[0-9]+$ ]] && ((w > 0)); then
    WIDTH=$w
    return
  fi
  pid=$$
  for _ in 1 2 3 4 5 6 7 8; do
    ppid=$(ps -o ppid= -p "$pid" 2>/dev/null) || break
    ppid=${ppid//[$' \t\r\n']/}
    if ! [[ $ppid =~ ^[0-9]+$ ]] || ((ppid <= 0)); then break; fi
    pid=$ppid
    tty=$(ps -o tty= -p "$pid" 2>/dev/null) || tty=''
    tty=${tty//[$' \t\r\n']/}
    [[ -n $tty && $tty != '??' && $tty != '?' ]] || continue
    w=$(stty size <"/dev/$tty" 2>/dev/null) || w=''
    w=${w##* }
    if [[ $w =~ ^[0-9]+$ ]] && ((w > 0)); then
      WIDTH=$w
      return
    fi
  done
  w=$(tput cols 2>/dev/null) || w=''
  w=${w//[$' \t\r\n']/}
  if [[ $w =~ ^[0-9]+$ ]] && ((w > 0)); then WIDTH=$w; fi
}

truncate_styled() { # styled-line target-visible-chars -> cut + "..."
  local s=$1 target=$2 out='' width=0 i=0 c j n
  n=${#s}
  if ((target <= 3)); then
    printf '%.*s' "$target" '...'
    return
  fi
  target=$((target - 3))
  while ((i < n)); do
    c=${s:i:1}
    if [[ $c == "$ESC" ]]; then
      j=$i
      while ((j < n)) && [[ ${s:j:1} != m ]]; do ((j += 1)); done
      out+=${s:i:j-i+1}
      i=$((j + 1))
      continue
    fi
    ((width >= target)) && break
    out+=$c
    ((width += 1, i += 1))
  done
  printf '%s...' "$out"
}

probe_width
if [[ -n $WIDTH ]]; then
  usable=$((WIDTH - 6)) # flexMode "full"
  total=$((proj_len + left_len + ctx_el_len + right_len))
  if ((total > usable)); then # overflow 1: swap the C bar for its text form
    ctx_el=$ctx_min_el ctx_el_len=$ctx_min_el_len
    total=$((proj_len + left_len + ctx_el_len + right_len))
  fi
  if ((total > usable)); then # overflow 2: drop the project name
    proj_el='' proj_len=0
    total=$((left_len + ctx_el_len + right_len))
  fi
  gap=$((usable - total))
  ((gap < 0)) && gap=0
  pad=''
  ((gap > 0)) && printf -v pad '%*s' "$gap" ''
  line="${proj_el}${left}${ctx_el}${pad}${right}"
  if ((total > usable)); then # overflow 3: truncate with ...
    line=$(truncate_styled "$line" "$usable")
  fi
else
  line="${proj_el}${left}${ctx_el}${ESC}[90m | ${ESC}[39m${right}"
fi

line="${ESC}[0m${line}"
printf '%s\n' "${line// /$NBSP}"

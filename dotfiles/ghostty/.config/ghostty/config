bold-color = bright
confirm-close-surface = false
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
# Font features for JetBrainsMono
# -calt: ligatures off
# -clig: contextual ligatures off
# -liga: standard ligatures off
# +zero: slashed zero
# +cv06: 'm' smaller middle apex
# +cv07: 'w' smaller middle apex
# +cv12: 'u' spur
# +cv14: '¢$' broken strikes
font-feature = -calt,-clig,-liga,+zero,+cv06,+cv07,+cv12,+cv14

# Keybinds live in includes because Ghostty loads `config-file` after the file
# that declares it, so `keybind = clear` has to sit in an earlier include than
# the binds it is meant to precede.
# keybinds-clear is generated by home-manager: `keybind = clear` on Linux,
# empty on macOS so the platform defaults (cmd+c, cmd+v, ...) survive.
config-file = ?keybinds-clear
config-file = ?keybinds

window-padding-x = 0
window-padding-y = 0
working-directory = home

config-file = ?../stylix/ghostty.conf
config-file = ?system

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["*.ts", "__tests__/*.ts", "pi-cliproxyapi-provider/**/*.ts", "pi-history/**/*.ts", "pi-subagents/**/*.ts", "workflow-provider/**/*.ts", "pi-workflows/**/*.ts"]
}

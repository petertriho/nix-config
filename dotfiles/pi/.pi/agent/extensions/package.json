{
  "name": "pi-extensions-dev",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Local dev types for pi extensions. pi injects the runtime packages; these devDependencies exist only for LSP type-checking.",
  "scripts": {
    "test": "node --test \"*.test.ts\" \"pi-history/*.test.ts\" \"pi-tmux-subagents/*.test.ts\" \"pi-workflows/workflow/*.test.ts\" \"workflow-provider/*.test.ts\" \"pi-workflows/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@earendil-works/pi-tui": "^0.86.1",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.10"
  }
}
